# Public URL of the deployed site, used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend API key for the enquiry form. Without it the form returns a clear error.
RESEND_API_KEY=

# Address that receives enquiries, and the verified sender address in Resend.
ENQUIRY_TO=krutiwatersolution@gmail.com
ENQUIRY_FROM=
